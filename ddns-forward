#!/bin/bash
# /usr/local/bin/ddns-forward
CONFIG_FILE="/etc/ddns-forward.ini"
CACHE_DIR="/var/run"
CHECK_INTERVAL=30
CLEAN=false
RELOAD=false
# --------- ARG PARSING ----------
while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--config)
            CONFIG_FILE="$2"
            shift 2
            ;;
        -i|--interval)
            CHECK_INTERVAL="$2"
            shift 2
            ;;
        --clean)
            CLEAN=true
            shift
            ;;
        --reload)
            RELOAD=true
            shift
            ;;
        *)
            echo "Unknown argument: $1"
            exit 1
            ;;
    esac
done
# --------- HELPERS ----------
is_ip() {
    [[ $1 =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]
}
resolve_target() {
    local TARGET=$1
    if is_ip "$TARGET"; then
        echo "$TARGET"
    else
        dig +short "$TARGET" | tail -n1
    fi
}
log_rule() {
    local ACTION=$1
    local LOCAL_IP=$2
    local LOCAL_PORT=$3
    local REMOTE_IP=$4
    local REMOTE_PORT=$5
    local PROTO=$6
    echo "[$ACTION][$PROTO] src=${LOCAL_IP}:${LOCAL_PORT} ->
dst=${REMOTE_IP}:${REMOTE_PORT}"
}
delete_rules() {
    local REMOTE_IP=$1
    local REMOTE_PORT=$2
    local LOCAL_IP=$3
    local LOCAL_PORT=$4
    local PROTO=$5
    /usr/sbin/iptables -t nat -D PREROUTING -p "$PROTO" --dport "$LOCAL_PORT" \
        -j DNAT --to-destination "$REMOTE_IP:$REMOTE_PORT" 2>/dev/null
    /usr/sbin/iptables -t nat -D POSTROUTING -p "$PROTO" -d "$REMOTE_IP" \
        --dport "$REMOTE_PORT" -j SNAT --to-source "$LOCAL_IP" 2>/dev/null
    log_rule "DEL" "$LOCAL_IP" "$LOCAL_PORT" "$REMOTE_IP" "$REMOTE_PORT" "$PROTO"
}
apply_rules() {
    local REMOTE_IP=$1
    local REMOTE_PORT=$2
    local LOCAL_IP=$3
    local LOCAL_PORT=$4
    local PROTO=$5
    /usr/sbin/iptables -t nat -A PREROUTING -p "$PROTO" --dport "$LOCAL_PORT" \
        -j DNAT --to-destination "$REMOTE_IP:$REMOTE_PORT"
    /usr/sbin/iptables -t nat -A POSTROUTING -p "$PROTO" -d "$REMOTE_IP" \
        --dport "$REMOTE_PORT" -j SNAT --to-source "$LOCAL_IP"
    log_rule "ADD" "$LOCAL_IP" "$LOCAL_PORT" "$REMOTE_IP" "$REMOTE_PORT" "$PROTO"
}
load_config() {
    FORWARDS=()
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "Warning: Config file $CONFIG_FILE not found. Running with empty rules."
        return
    fi
    local remote_target remote_port local_target local_port proto
    while IFS='=' read -r key val || [ -n "$key" ]; do
        # Trim leading/trailing whitespace and carriage returns
        key=$(echo "$key" | xargs 2>/dev/null)
        val=$(echo "$val" | xargs 2>/dev/null)
        # Skip section headers, blank lines, or comments
        [[ "$key" =~ ^\[.*\]$ || -z "$key" || "$key" =~ ^# ]] && continue
        case "$key" in
            remote_target) remote_target="$val" ;;
            remote_port)   remote_port="$val" ;;
            local_target)  local_target="$val" ;;
            local_port)    local_port="$val" ;;
            proto)
                proto="$val"
                FORWARDS+=("${remote_target}|${remote_port}|${local_target}|${local_port}|${proto}")
                ;;
        esac
    done < "$CONFIG_FILE"
}
# --------- FIXED DISK-BASED CLEANUP ----------
clean_all_rules() {
    echo "Cleaning managed iptables rules and cache from state files..."
    for CACHE_FILE in "$CACHE_DIR"/fwd_cache_*.state; do
        [ -f "$CACHE_FILE" ] || continue
        # Read state values directly stored inside file content
        IFS='|' read -r OLD_REMOTE_IP OLD_LOCAL_IP REMOTE_PORT LOCAL_PORT PROTO < "$CACHE_FILE"
        PROTO=$(echo "$PROTO" | tr '[:upper:]' '[:lower:]')
        [[ "$PROTO" == "both" || -z "$PROTO" ]] && PROTOS=("tcp" "udp") || PROTOS=("$PROTO")
        if [ -n "$OLD_REMOTE_IP" ] && [ -n "$OLD_LOCAL_IP" ]
&& [ -n "$REMOTE_PORT" ] && [ -n "$LOCAL_PORT" ]; then
            for p in "${PROTOS[@]}"; do
                delete_rules "$OLD_REMOTE_IP" "$REMOTE_PORT"
"$OLD_LOCAL_IP" "$LOCAL_PORT" "$p"
            done
        fi
        rm -f "$CACHE_FILE"
        echo "Purged state file: $(basename "$CACHE_FILE")"
    done
}
# --------- CLEAN MODE ----------
if $CLEAN; then
    clean_all_rules
    exit 0
fi
# --------- RELOAD (one-shot) ----------
if $RELOAD; then
    echo "Reload requested: flushing rules and applying config ($CONFIG_FILE)..."
    clean_all_rules
    load_config
    for ENTRY in "${FORWARDS[@]}"; do
        IFS='|' read -r REMOTE_TARGET REMOTE_PORT LOCAL_TARGET LOCAL_PORT PROTO <<< "$ENTRY"
        PROTO=$(echo "$PROTO" | tr '[:upper:]' '[:lower:]')
        [[ "$PROTO" == "both" ]] && PROTOS_TO_APPLY=("tcp" "udp") || PROTOS_TO_APPLY=("$PROTO")
        CURRENT_REMOTE_IP=$(resolve_target "$REMOTE_TARGET")
        CURRENT_LOCAL_IP=$(resolve_target "$LOCAL_TARGET")
        if [ -z "$CURRENT_REMOTE_IP" ] || [ -z "$CURRENT_LOCAL_IP" ]; then
            echo "Error: Could not resolve $REMOTE_TARGET or
$LOCAL_TARGET. Skipping..."
            continue
        fi
        for p in "${PROTOS_TO_APPLY[@]}"; do
            apply_rules "$CURRENT_REMOTE_IP" "$REMOTE_PORT" "$CURRENT_LOCAL_IP" "$LOCAL_PORT" "$p"
        done
        SAFE_REMOTE=$(echo "$REMOTE_TARGET" | tr '.' '_')
        SAFE_LOCAL=$(echo "$LOCAL_TARGET" | tr '.' '_')
        CACHE_FILE="$CACHE_DIR/fwd_cache_${SAFE_REMOTE}_${REMOTE_PORT}_to_${SAFE_LOCAL}_${LOCAL_PORT}_${PROTO}.state"
        # Save complete rule state inside file
        echo "${CURRENT_REMOTE_IP}|${CURRENT_LOCAL_IP}|${REMOTE_PORT}|${LOCAL_PORT}|${PROTO}" > "$CACHE_FILE"
    done
    echo "Reload complete."
    exit 0
fi
# --------- MAIN LOOP ----------
LAST_MOD=0
echo "Starting DDNS forward loop (Config: $CONFIG_FILE, Interval: ${CHECK_INTERVAL}s)..."
while true; do
    # Auto-reload if configuration file modified
    if [ -f "$CONFIG_FILE" ]; then
        CURRENT_MOD=$(stat -c %Y "$CONFIG_FILE" 2>/dev/null)
        if [ "$CURRENT_MOD" -gt "$LAST_MOD" ]; then
            echo "Configuration change detected in $CONFIG_FILE. Reloading rules..."
            clean_all_rules
            load_config
            LAST_MOD=$CURRENT_MOD
        fi
    fi
    for ENTRY in "${FORWARDS[@]}"; do
        IFS='|' read -r REMOTE_TARGET REMOTE_PORT LOCAL_TARGET LOCAL_PORT PROTO <<< "$ENTRY"
        PROTO=$(echo "$PROTO" | tr '[:upper:]' '[:lower:]')
        [[ "$PROTO" == "both" ]] && PROTOS_TO_APPLY=("tcp" "udp") || PROTOS_TO_APPLY=("$PROTO")
        CURRENT_REMOTE_IP=$(resolve_target "$REMOTE_TARGET")
        CURRENT_LOCAL_IP=$(resolve_target "$LOCAL_TARGET")
        if [ -z "$CURRENT_REMOTE_IP" ] || [ -z "$CURRENT_LOCAL_IP" ]; then
            echo "Error: Could not resolve $REMOTE_TARGET or
$LOCAL_TARGET. Skipping..."
            continue
        fi
        SAFE_REMOTE=$(echo "$REMOTE_TARGET" | tr '.' '_')
        SAFE_LOCAL=$(echo "$LOCAL_TARGET" | tr '.' '_')
        CACHE_FILE="$CACHE_DIR/fwd_cache_${SAFE_REMOTE}_${REMOTE_PORT}_to_${SAFE_LOCAL}_${LOCAL_PORT}_${PROTO}.state"
        OLD_REMOTE_IP=""
        OLD_LOCAL_IP=""
        if [ -f "$CACHE_FILE" ]; then
            IFS='|' read -r OLD_REMOTE_IP OLD_LOCAL_IP _ _ _
< "$CACHE_FILE"
        fi
        if [ "$CURRENT_REMOTE_IP" != "$OLD_REMOTE_IP" ] || [
"$CURRENT_LOCAL_IP" != "$OLD_LOCAL_IP" ]; then
            OLD_SRC="${OLD_LOCAL_IP:+$OLD_LOCAL_IP:$LOCAL_PORT}"
            OLD_DST="${OLD_REMOTE_IP:+$OLD_REMOTE_IP:$REMOTE_PORT}"
            echo "Change Detected for ${REMOTE_TARGET}:${REMOTE_PORT} -> ${LOCAL_TARGET}:${LOCAL_PORT} | Old: src=${OLD_SRC:-none} -> dst=${OLD_DST:-none} ; New: src=${CURRENT_LOCAL_IP}:${LOCAL_PORT} -> dst=${CURRENT_REMOTE_IP}:${REMOTE_PORT}"
            for p in "${PROTOS_TO_APPLY[@]}"; do
                if [ -n "$OLD_REMOTE_IP" ] && [ -n "$OLD_LOCAL_IP" ]; then
                    delete_rules "$OLD_REMOTE_IP" "$REMOTE_PORT" "$OLD_LOCAL_IP" "$LOCAL_PORT" "$p"
                fi
                apply_rules "$CURRENT_REMOTE_IP" "$REMOTE_PORT" "$CURRENT_LOCAL_IP" "$LOCAL_PORT" "$p"
            done
            # Save complete rule state inside file
            echo "${CURRENT_REMOTE_IP}|${CURRENT_LOCAL_IP}|${REMOTE_PORT}|${LOCAL_PORT}|${PROTO}" > "$CACHE_FILE"
        fi
    done
    sleep "$CHECK_INTERVAL"
done
